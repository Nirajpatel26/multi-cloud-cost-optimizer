pipeline {
    agent any

    environment {
        // Project paths
        PROJECT_ROOT = "${WORKSPACE}"
        BACKEND_DIR = "${PROJECT_ROOT}/backend"

        // Docker image names
        BACKEND_MOCK_IMAGE = "mcco-backend-mock:${BUILD_NUMBER}"
        BACKEND_AWS_IMAGE = "mcco-backend-aws:${BUILD_NUMBER}"
        FRONTEND_IMAGE = "mcco-frontend:${BUILD_NUMBER}"
    }

    stages {
        stage('Setup') {
            steps {
                echo 'Installing Docker Compose if not present...'
                sh '''
                    if ! docker-compose version > /dev/null 2>&1; then
                        curl -SL "https://github.com/docker/compose/releases/download/v2.24.5/docker-compose-linux-x86_64" \
                            -o /usr/local/bin/docker-compose
                        chmod +x /usr/local/bin/docker-compose
                    fi
                    docker-compose version
                '''
            }
        }

        stage('Checkout') {
            steps {
                echo 'Checking out code from repository...'
                checkout scm

                script {
                    sh 'git log -1 --oneline'
                    sh 'git branch -v'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing Python dependencies...'
                dir("${BACKEND_DIR}") {
                    script {
                        sh '''
                            python3 -m venv venv
                            . venv/bin/activate
                            pip install --upgrade pip
                            pip install -r requirements.txt
                        '''
                    }
                }
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running tests...'
                dir("${BACKEND_DIR}") {
                    script {
                        sh '''
                            . venv/bin/activate
                            pytest app/tests/ -v --tb=short
                        '''
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                echo 'Building Docker images...'
                script {
                    // Build mock backend
                    sh """
                        docker build -t ${BACKEND_MOCK_IMAGE} \
                        --build-arg ENV_TYPE=mock \
                        -f backend/Dockerfile ./backend
                    """

                    // Build AWS backend
                    sh """
                        docker build -t ${BACKEND_AWS_IMAGE} \
                        --build-arg ENV_TYPE=aws \
                        -f backend/Dockerfile ./backend
                    """

                    // Build frontend
                    sh """
                        docker build -t ${FRONTEND_IMAGE} \
                        -f frontend/Dockerfile ./frontend
                    """
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying containers...'
                script {
                    // Restart only app services — exclude jenkins to avoid self-shutdown
                    sh 'docker-compose up -d --no-deps backend-mock backend-aws frontend'
                    sh 'docker ps'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
        always {
            echo 'Cleaning up...'
            sh '''
                if [ -d "backend/venv" ]; then
                    rm -rf backend/venv
                fi
            '''
        }
    }
}
